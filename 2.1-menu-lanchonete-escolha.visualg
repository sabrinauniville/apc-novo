algoritmo "MenuLanchonete1"

var
  opcao: inteiro

inicio
  escreval("1- Hambúrguer | 2 - Pizza | 3 - Salada")
  leia(opcao)
  escreval(opcao)

  escolha opcao
    caso 1
      escreval("Escolhido o Hambúrguer...")

    caso 2
      escreval("Escolhida a Pizza...")

    caso 3
      escreval("Escolhida a Salada...")
  fimescolha
  
  escreval("Fim.")
fimalgoritmo
